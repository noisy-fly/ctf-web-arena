FROM ctf-web-arena:opensource
RUN sed -i 's/listen 80 default_server;/listen 127.0.0.1:80 default_server; listen 127.0.0.1:18763;/' /etc/nginx/sites-available/ctf && sed -i 's/listen 8090 default_server;/listen 127.0.0.1:8090 default_server;/' /etc/nginx/sites-available/ctf && sed -i 's/listen 8307 default_server;/listen 127.0.0.1:8307 default_server;/' /etc/nginx/sites-available/ctf && printf '[automount]\nenabled=false\n[interop]\nenabled=false\nappendWindowsPath=false\n' > /etc/wsl.conf && sed -i '/# ---------- MariaDB ----------/a mkdir -p /run/mysqld\nchown mysql:mysql /run/mysqld' /entry.sh
